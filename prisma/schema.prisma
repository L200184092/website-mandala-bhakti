generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Pendaftar {
  id               Int    @id @default(autoincrement())
  nomorPendaftaran String @unique
  program          String
  nama             String
  phone            String
  email            String
  address          String
  school           String
  graduationYear   String

  // Dokumen baru
  identityDocumentName String?
  identityDocumentPath String?

  diplomaDocumentName String?
  diplomaDocumentPath String?

  familyDocumentName String?
  familyDocumentPath String?

  photoDocumentName String?
  photoDocumentPath String?

  // Dokumen lama — sementara dipertahankan
  documentName String?
  documentPath String?

  status    String   @default("MENUNGGU_VERIFIKASI")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PesanKontak {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("BARU")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}